{
  // The release suite: the cross-path parity gate and the packaging and
  // deployment checks. Browser code (the gate renders on a real GPU) plus a few
  // Node-side tests, so it is typechecked apart from the library — whose
  // tsconfig declares `types: []` on purpose — and apart from the demo, which
  // it imports but does not belong to.
  //
  // `paths` mirrors vite.config.ts: the public specifiers resolve to the library
  // source, so a breaking change to an export fails here before it reaches a
  // release.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "three-vat": ["../src/index.ts"],
      "three-vat/webgl": ["../src/webgl.ts"],
      "three-vat/tsl": ["../src/tsl.ts"]
    }
  },
  // The gate's page detects WebGPU with the demo's own `support.ts`, whose
  // `navigator.gpu` declaration is ambient and so has to be named to be seen
  // from here. Pulled in one file at a time rather than by including the demo's
  // whole `src`: the demo has its own tsconfig and typechecks itself.
  "include": [".", "../examples/src/webgpu/navigator-gpu.d.ts"]
}
