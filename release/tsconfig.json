{
  // The release suite: the cross-path parity gate and the packaging and
  // deployment checks. Browser code (the gate renders on a real GPU) plus a few
  // Node-side tests, so it is typechecked apart from the library — whose
  // tsconfig declares `types: []` on purpose — and apart from the demo, which
  // it imports but does not belong to.
  //
  // `paths` mirrors vite.config.ts: the public specifiers resolve to the library
  // source, so a breaking change to an export fails here before it reaches a
  // release.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // The hero capture is plain JavaScript — it runs under bare `node`, so it
    // cannot be TypeScript — but its two pure halves are imported by tests that
    // are. `allowJs` is what lets those tests read the JSDoc on them. Not
    // `checkJs`: the node-side scripts here and in `release/parity` reach for
    // the whole of node, and this project typechecks browser code.
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "three-vat": ["../src/index.ts"],
      "three-vat/webgl": ["../src/webgl.ts"],
      "three-vat/tsl": ["../src/tsl.ts"]
    }
  },
  // The gate's page detects WebGPU with the demo's own `support.ts`, whose
  // `navigator.gpu` declaration is ambient and so has to be named to be seen
  // from here. Pulled in one file at a time rather than by including the demo's
  // whole `src`: the demo has its own tsconfig and typechecks itself.
  // `../scripts` for the same reason `allowJs` is on: the publish command is
  // plain JavaScript running under bare `node`, and the test beside it is
  // TypeScript that reads its JSDoc. Nothing else typechecked that folder,
  // which is how a release script that could not release shipped green.
  "include": [".", "../scripts", "../examples/src/webgpu/navigator-gpu.d.ts"]
}
