{
  // The game is typechecked with the rest of the repo (ADR-0038): it is the
  // library's heaviest consumer, so a change to an export breaks here before it
  // breaks in a browser. `paths` mirrors vite.config.ts — the public specifiers
  // resolve to the library source, as they do for the examples.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "three-vat": ["../../src/index.ts"],
      "three-vat/webgl": ["../../src/webgl.ts"],
      "three-vat/tsl": ["../../src/tsl.ts"],
      "three-vat/write": ["../../src/write.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
