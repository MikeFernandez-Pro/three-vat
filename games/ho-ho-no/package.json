{
  "name": "ho-ho-no",
  "private": true,
  "type": "module",
  "scripts": {
    "bake": "pnpm --dir ../.. build && node ../../dist/bin.js bake models/skull.glb --out public/models/skeleton.vat.glb && node ../../dist/bin.js bake models/elf.glb --out public/models/elf.vat.glb",
    "dev": "pnpm bake && vite",
    "build": "pnpm bake && vite build",
    "test": "pnpm bake && vitest run",
    "test:watch": "pnpm bake && vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "gsap": "^3.14.1",
    "howler": "^2.2.4",
    "three": "^0.186.0",
    "three-vat": "workspace:*"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vitest": "^2.1.0"
  }
}
