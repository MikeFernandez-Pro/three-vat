{
  "name": "three-vat",
  "version": "1.0.0",
  "description": "Bake glTF animation clips into vertex animation textures for zero-CPU instanced crowds in three.js.",
  "type": "module",
  "license": "MIT",
  "author": "Mike Fernandez <mike.fernandez.sec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeFernandez-Pro/three-vat.git"
  },
  "bugs": {
    "url": "https://github.com/MikeFernandez-Pro/three-vat/issues"
  },
  "homepage": "https://github.com/MikeFernandez-Pro/three-vat#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.19.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js"
    },
    "./tsl": {
      "types": "./dist/tsl.d.ts",
      "import": "./dist/tsl.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:test-assets": "node scripts/fetch-test-assets.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:release": "tsc --noEmit -p release/tsconfig.json",
    "prepublishOnly": "pnpm typecheck && pnpm typecheck:release && pnpm test && pnpm build",
    "release": "pnpm publish ${NPM_OTP:+--otp=\"$NPM_OTP\"} && pnpm verify:published",
    "verify:published": "node scripts/verify-published.mjs",
    "parity": "node release/parity/check.mjs",
    "example": "pnpm --filter three-vat-example dev",
    "build:examples": "pnpm --filter three-vat-example build",
    "test:examples": "pnpm --filter three-vat-example test",
    "typecheck:examples": "pnpm --filter three-vat-example typecheck"
  },
  "keywords": [
    "three",
    "threejs",
    "vat",
    "vertex-animation-texture",
    "instancing",
    "instancedmesh",
    "crowd",
    "animation",
    "skinning",
    "webgpu",
    "tsl"
  ],
  "peerDependencies": {
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "three": "^0.185.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
