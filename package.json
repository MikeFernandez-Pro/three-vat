{
  "name": "three-vat",
  "version": "1.0.1",
  "description": "Bake glTF animation clips into vertex animation textures for zero-CPU instanced crowds in three.js.",
  "type": "module",
  "license": "MIT",
  "author": "Mike Fernandez <mike.fernandez.sec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeFernandez-Pro/three-vat.git"
  },
  "bugs": {
    "url": "https://github.com/MikeFernandez-Pro/three-vat/issues"
  },
  "homepage": "https://github.com/MikeFernandez-Pro/three-vat#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.19.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js"
    },
    "./tsl": {
      "types": "./dist/tsl.d.ts",
      "import": "./dist/tsl.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter three-vat-example dev",
    "test": "vitest run && pnpm --filter three-vat-example test",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p release/tsconfig.json && pnpm --filter three-vat-example typecheck",
    "build:watch": "tsup --watch",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "three",
    "threejs",
    "vat",
    "vertex-animation-texture",
    "instancing",
    "instancedmesh",
    "crowd",
    "animation",
    "skinning",
    "webgpu",
    "tsl"
  ],
  "peerDependencies": {
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "gifenc": "1.0.3",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "three": "^0.186.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    ".",
    "examples"
  ]
}
